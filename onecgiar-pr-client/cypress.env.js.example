// Cypress environment configuration for local development.
// Copy this file to cypress.env.js and update with your own values.
// cypress.env.js is gitignored — every developer keeps their own copy.
//
// NOTE: cypress.config.js loads this file with require(), so it must be CommonJS.
// The key names below are the ones cypress.config.js actually reads
// (guestEmail / guestPassword / userToken).

const environment = {
  cypress: {
    // ---------------------------------------------------------------------
    // Slow path — UI login (cy.login('guest')). Types the form on /login.
    // ---------------------------------------------------------------------
    guestEmail: 'your-test-email@domain.com',
    guestPassword: 'your-test-password',

    // ---------------------------------------------------------------------
    // Fast path — session login (cy.loginByToken()). PREFERRED.
    // Raw JWT string, exactly what the app keeps in localStorage['token'].
    // Grab it from DevTools > Application > Local Storage > token after
    // logging in once in the browser.
    // NEVER commit this value.
    // ---------------------------------------------------------------------
    userToken: ''
  }
};

module.exports = { environment };
