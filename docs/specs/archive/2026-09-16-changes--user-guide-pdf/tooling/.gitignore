# Dependencies
node_modules/

# Secrets — never commit real credentials
.env

# Ephemeral capture output (regenerated by capture.ts on every run)
raw/

# Intermediate build artifacts — only the final PDF is committed (see design.md §2)
dist/*.html
dist-ts/

# Live design-token extraction output (regenerated by tokens.ts on every run)
tokens.json

# Playwright/test tooling artifacts
test-results/
playwright-report/
playwright/.cache/
