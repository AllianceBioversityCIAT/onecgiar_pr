# Copy this file to `.env` (gitignored) and fill in real local values.
# NEVER commit `.env` or paste real values into this example file.

# Base URL of the running local client (docs/infrastructure.md §6).
CLIENT_BASE_URL=http://localhost:4200

# Option A: a pre-obtained, real JWT from an actual login (preferred — see UG-DD-4).
# Leave TEST_USER_EMAIL/TEST_USER_PASSWORD empty if you use this.
TEST_TOKEN=

# Option B: real login-form credentials for a representative end-user role,
# used only if TEST_TOKEN is not set. Leave both empty if you use TEST_TOKEN instead.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Optional: Playwright browser channel (e.g. `chrome`) to launch instead of the
# bundled Chromium. Leave unset to use bundled Chromium (the default). Needed
# in environments where the bundled Chromium cannot be downloaded and a system
# Chrome install is used instead.
PLAYWRIGHT_CHANNEL=
