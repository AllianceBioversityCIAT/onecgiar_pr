# Backend image deployed to Reporting Tool DEV by the ONECGIAR CI/CD Platform.
#
# Equivalent of the `development` stage of ./Dockerfile, which the Jenkins DEV job builds with
# `--target development`; built by .github/workflows/reporting-tool-dev-cicd.yml (job build-and-push).
# Kept as its own file so the deployed DEV image installs exactly the lockfile (see below) without
# changing ./Dockerfile, which other jobs may still use. Keep both in sync.
#
# Differences from the `development` stage, on purpose:
#   * `npm ci` instead of `npm install` (reproducible: exactly the lockfile).
#   * no `npm install --save-dev @types/node` (already a devDependency in the lockfile).
# The image keeps the dev dependencies and the TypeScript sources because the deploy script runs
# `npm run migration:check:ci` and `npm run migration:run` (ts-node) with this same image.
# Migrations are NEVER run at build time.
FROM node:20.13.1-alpine

WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts

COPY src ./src
COPY tsconfig*.json ./
COPY nest-cli.json ./
COPY eslint.config.mjs ./
COPY scripts ./scripts

RUN npm run build

CMD ["npm", "run", "start"]
